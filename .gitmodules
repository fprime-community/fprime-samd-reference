[submodule "fprime"]
	path = lib/fprime
	url = https://github.com/nasa/fprime.git
[submodule "fprime-baremetal"]
	path = lib/fprime-baremetal
	url = https://github.com/fprime-community/fprime-baremetal.git
[submodule "fprime-samd"]
	path = lib/fprime-samd
	url = https://github.com/fprime-community/fprime-samd.git
[submodule "lib/fprime-devices"]
	path = lib/fprime-devices
	url = https://github.com/fprime-community/fprime-devices.git
	branch = main
