{
  "name": "F Prime SAMD21 Reference",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "jet-propulsion-laboratory.fpp"
      ],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "root"
}
